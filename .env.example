# Copy to .env and fill in real values. Never commit .env.

# ---- Postgres (used by both the postgres container and the API) ----
POSTGRES_USER=rentwise
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=rentwise

# Inside Docker the host is the service name `postgres`.
# For running the API on the host against a containerised DB use localhost:5432.
DATABASE_URL=postgresql://rentwise:change-me-in-production@postgres:5432/rentwise?schema=public

# ---- API ----
NODE_ENV=development
PORT=4000

# Generate each with:  openssl rand -base64 48
# Must be at least 32 characters. Use DIFFERENT values for the two secrets.
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-base64-48-value

JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000
# Cookie domain, applied in production only.
COOKIE_DOMAIN=localhost

# ---- Web (build-time) ----
# Left empty so the browser calls same-origin /api through nginx.
VITE_API_BASE_URL=
