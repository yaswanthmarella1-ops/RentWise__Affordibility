# ---------- build ----------
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile --filter @rentwise/web... --filter @rentwise/shared...

COPY packages/shared ./packages/shared
COPY apps/web ./apps/web

# Baked in at build time by Vite. Empty means "same origin", so the browser
# calls /api and nginx proxies it to the API container.
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN pnpm --filter @rentwise/shared build \
 && pnpm --filter @rentwise/web build

# ---------- runner ----------
FROM nginx:1.27-alpine AS runner

COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# 127.0.0.1, not localhost: `listen 80` binds IPv4 only, and localhost inside
# the container resolves to ::1 first, which would refuse the connection.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
